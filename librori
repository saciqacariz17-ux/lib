local function lolly_b64dec(s)
	if type(s) ~= "string" or #s == 0 then
		return nil;
	end;
	if base64decode then
		local ok, res = pcall(base64decode, s);
		if ok and type(res) == "string" and #res > 0 then
			return res;
		end;
	end;
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
	local lut = {};
	for i = 1, #chars do
		lut[string.byte(chars, i, i)] = i - 1;
	end;
	local out, n, acc, bits = {}, 0, 0, 0;
	for i = 1, #s do
		local v = lut[string.byte(s, i, i)];
		if v then
			acc = bit32.bor(bit32.lshift(acc, 6), v);
			bits = bits + 6;
			if bits >= 8 then
				bits = bits - 8;
				n = n + 1;
				out[n] = string.char(bit32.band(bit32.rshift(acc, bits), 255));
			end;
		end;
	end;
	return table.concat(out);
end

