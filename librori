local LIBRARY_URL = "https://raw.githubusercontent.com/saciqacariz17-ux/lib/refs/heads/main/librori"
assert(LIBRARY_URL ~= "PASTE_YOUR_RAW_LIBRARY_URL_HERE", "Укажите ссылку на библиотеку в LIBRARY_URL")
local source = game:HttpGet(LIBRARY_URL .. "?v=thin-4305f2430915", true)
local chunk, compileError = loadstring(source, "LollyGUI")
assert(chunk, compileError)
local lib = chunk()
assert(type(lib) == "table" and type(lib.window) == "function", "Библиотека должна возвращать lib")
assert(lib.previewRevision == "thin-4305f2430915", "Lolly: загружена старая библиотека. Обновите librori на GitHub файлом LollyGUI.lua с исправленными кадрами.")

local win = lib:window({
    title    = "Lolly",
    folder   = "Lolly",
    key      = "Insert",
    font     = false,
    size     = {760, 560},
    preview_fps = 12,
})
local tabs = {
    {name = "test 1", icon = "rbxassetid://133109875194066"},
    {name = "test 2", icon = "rbxassetid://133109875194066"},
    {name = "test 3", icon = "rbxassetid://133109875194066"},
    {name = "test 4", icon = "rbxassetid://133109875194066"},
    {name = "test 5", icon = "rbxassetid://133109875194066"},
}
local mainTab = {name = "main", icon = "rbxassetid://133109875194066"}
local headerTabs = {"test", "test 1", "test 2"}

for i, tabConfig in ipairs(tabs) do
    local t = win:tab(tabConfig)
    t:section({
        name = i == 1 and "Personalize" or "",
        panes = true,
        headerTabs = headerTabs,
        firstPane = i == 1 and function(panel)
            local accent = Color3.fromRGB(216, 157, 196)
            local softAccent = true
            local function applyAccent()
                lib:settheme("acc", softAccent and accent:Lerp(Color3.new(1, 1, 1), 0.18) or accent)
            end
            local left, right = panel:columns()
            left:head("Your space")
            left:label({text = "A little color. A softer mood."})
            right:head("Appearance")
            right:colorpicker({
                name = "Accent color", flag = "test1_accent", default = accent,
                cb = function(color)
                    accent = color
                    applyAccent()
                end,
            })
            right:toggle({
                name = "Soft accent", flag = "test1_soft_accent", default = true,
                cb = function(enabled)
                    softAccent = enabled
                    applyAccent()
                end,
            })
            applyAccent()
        end or nil,
        secondPane = i == 1 and function(panel)
        end or nil,
    })
end
local tab = win:tab(mainTab)
tab:section({name = "", panes = true, headerTabs = headerTabs})

return lib
